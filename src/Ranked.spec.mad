import {} from "Show"
import String from "String"

import { report } from "Study"

import { n2, n3, n4, n5, n6, n7, n8, n9 } from "@/Ranked"
import Un from "@/Unranked"



// direct application of values, coverage gives us confidence

nine = (a, b, c, d, e, f, g, h, i) => String.fromList([a, b, c, d, e, f, g, h, i])
report(n2(nine('1', '2', '3', '4', '5', '6', '7')), "n2", [#[#['a', 'b'], "1234567ab"]])
report(n3(nine('1', '2', '3', '4', '5', '6')), "n3", [#[#['a', 'b', 'c'], "123456abc"]])
report(n4(nine('1', '2', '3', '4', '5')), "n4", [#[#['a', 'b', 'c', 'd'], "12345abcd"]])
report(n5(nine('1', '2', '3', '4')), "n5", [#[#['a', 'b', 'c', 'd', 'e'], "1234abcde"]])
report(n6(nine('1', '2', '3')), "n6", [#[#['a', 'b', 'c', 'd', 'e', 'f'], "123abcdef"]])
report(n7(nine('1', '2')), "n7", [#[#['a', 'b', 'c', 'd', 'e', 'f', 'g'], "12abcdefg"]])
report(n8(nine('1')), "n8", [#[#['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'], "1abcdefgh"]])
report(n9(nine), "n9", [#[#['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i'], "abcdefghi"]])
report(Un.un9(n9(nine), 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'), "un9", [#['i', "abcdefghi"]])
report(Un.un8(n8(nine('1')), 'a', 'b', 'c', 'd', 'e', 'f', 'g'), "un8", [#['i', "1abcdefgi"]])
report(Un.un7(n7(nine('1', '2')), 'a', 'b', 'c', 'd', 'e', 'f'), "un7", [#['i', "12abcdefi"]])
report(Un.un6(n6(nine('1', '2', '3')), 'a', 'b', 'c', 'd', 'e'), "un6", [#['i', "123abcdei"]])
report(Un.un5(n5(nine('1', '2', '3', '4')), 'a', 'b', 'c', 'd'), "un5", [#['i', "1234abcdi"]])
report(Un.un4(n4(nine('1', '2', '3', '4', '5')), 'a', 'b', 'c'), "un4", [#['i', "12345abci"]])
report(Un.un3(n3(nine('1', '2', '3', '4', '5', '6')), 'a', 'b'), "un3", [#['i', "123456abi"]])
report(Un.un2(n2(nine('1', '2', '3', '4', '5', '6', '7')), 'a'), "un2", [#['i', "1234567ai"]])

// there's a limit on tuples to max 9 currently, so we're eschewing this behavior
// ten = (a, b, c, d, e, f, g, h, i, j) => String.fromList([a, b, c, d, e, f, g, h, i, j])
// report(n10(ten), "denary", [#[#['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j'], "abcdefghij"]])
