import Dict from "Dictionary"
import Maybe from "Maybe"



// pretty sure this still monomorphizes on arity, so you can only reuse the
// dictionaries of same arity
export memoizeWithDictionary = (dict, fun) => {
  saved = dict
  record = () => saved
  get = (xx) => pipe(
    Dict.get($, record()),
    where {
      Maybe.Just(x) =>
        x

      Maybe.Nothing =>
        do {
          yy = fun(xx)
          saved := Dict.insert(xx, yy, saved)
          return yy
        }
    },
  )(xx)
  return { record, get }
}
export memoizeWith = memoizeWithDictionary(Dict.empty)
// if you don't need the raw accessor
export memoize = pipe(
  memoizeWith,
  .get,
)
