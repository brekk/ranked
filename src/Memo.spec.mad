import Dict from "Dictionary"
import IO from "IO"
import Math from "Math"
import Tuple from "Tuple"

import Study from "Study"

import M from "@/Memo"
import R from "@/Ranked"



powTuple :: #[Float, Float] -> Float
powTuple = R.n2(Math.pow)
// if you uncomment the IO here you'll see that even though we're hitting the memoized values on the third run
// we could write a test for this but that sounds exhausting when we could just publish this
powpow = pipe(
  // IO.pTrace("runcheck"),
  powTuple,
)
double2 = #[2, 2]
two4 = #[2, 4]
Study.report(M.memoize(powpow), "memoize!", [#[double2, 4], #[two4, 16], #[two4, 16]])
// ok, because I'm a glutton for punishment, let's prove it
// we can set an incorrect memoized value, which is tricky and interesting

LIES = Dict.fromList([#[double2, 100], #[two4, 150]])
xx = M.memoizeWithDictionary(LIES, powpow)
Study.report(
  Tuple.snd(xx),
  "memoizeWithDictionary won't run the function if there's a prior value in the lookup",
  [#[#[1, 1], 1], #[double2, 100], #[two4, 150]],
)
